# Playwright storefront tests for the newsletter sign-up module.
# Copy this file to .env and fill in the values for your store.

# Base URL of the store (no trailing slash)
PLAYWRIGHT_BASE_URL=https://shop.example.com

# Store view codes. The tests pick a store view with Magento's "store" cookie.
# Leave a code empty to use the store view the base URL opens.
# Leave a project's code empty AND set its *_ENABLED to 0 to skip that project.
LUMA_ENABLED=1
LUMA_STORE_CODE=
HYVA_ENABLED=0
HYVA_STORE_CODE=

# Checkout used by the Hyvä store view: "hyva" (Hyvä Checkout) or "luma" (Magento's own checkout)
HYVA_CHECKOUT=hyva

# Product to buy: the entity id of a simple product that is in stock and needs no options
PRODUCT_ID=1

# Shipping and payment for the test orders
SHIPPING_METHOD=flatrate_flatrate
PAYMENT_METHOD=checkmo

# Shipping address for guest orders (placeholders only)
ADDRESS_COUNTRY=AT
ADDRESS_POSTCODE=1010
ADDRESS_CITY=Exampletown
ADDRESS_STREET=Example Street 1
ADDRESS_TELEPHONE=+43 000 000000

# Domain for the fresh email addresses each run creates. Use a reserved domain (RFC 2606).
EMAIL_DOMAIN=example.com
