<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Store:etc/config.xsd">
    <default>
        <newsletter>
            <signup_checkout>
                <enabled>1</enabled>
                <hide_unsubscribed>0</hide_unsubscribed>
            </signup_checkout>
            <signup_confirmation_page>
                <enabled>1</enabled>
                <hide_unsubscribed>0</hide_unsubscribed>
                <benefit_text>Subscribe to our newsletter and be the first to hear about new products and offers.</benefit_text>
                <tracking_params/>
            </signup_confirmation_page>
        </newsletter>
    </default>
</config>
