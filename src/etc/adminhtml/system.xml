<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Config:etc/system_file.xsd">
    <system>
        <section id="newsletter">
            <group id="signup_checkout" translate="label" sortOrder="180" showInDefault="1"
                   showInWebsite="1" showInStore="1">
                <label>Sign-up Line in the Checkout</label>
                <field id="enabled" translate="label comment" type="select" sortOrder="10" showInDefault="1"
                       showInWebsite="1" showInStore="1">
                    <label>Enabled</label>
                    <source_model>Magento\Config\Model\Config\Source\Yesno</source_model>
                    <comment>An unticked box above the place order button, shown to shoppers whose email is not subscribed yet.</comment>
                </field>
                <field id="hide_unsubscribed" translate="label comment" type="select" sortOrder="20"
                       showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Hide for Unsubscribed</label>
                    <source_model>Magento\Config\Model\Config\Source\Yesno</source_model>
                    <comment>By default, people who unsubscribed earlier are invited back.</comment>
                    <depends>
                        <field id="enabled">1</field>
                    </depends>
                </field>
                <field id="benefit_text" translate="label comment" type="textarea" sortOrder="30" showInDefault="1"
                       showInWebsite="1" showInStore="1">
                    <label>Benefit Text</label>
                    <comment>The label of the box. Plain text.</comment>
                    <depends>
                        <field id="enabled">1</field>
                    </depends>
                </field>
            </group>
            <group id="signup_confirmation_page" translate="label" sortOrder="190" showInDefault="1"
                   showInWebsite="1" showInStore="1">
                <label>Sign-up Block on the Order Confirmation Page</label>
                <field id="enabled" translate="label comment" type="select" sortOrder="10" showInDefault="1"
                       showInWebsite="1" showInStore="1">
                    <label>Enabled</label>
                    <source_model>Magento\Config\Model\Config\Source\Yesno</source_model>
                    <comment>Shown to shoppers whose order email is not subscribed yet.</comment>
                </field>
                <field id="hide_unsubscribed" translate="label comment" type="select" sortOrder="20"
                       showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Hide for Unsubscribed</label>
                    <source_model>Magento\Config\Model\Config\Source\Yesno</source_model>
                    <comment>By default, people who unsubscribed earlier are invited back.</comment>
                    <depends>
                        <field id="enabled">1</field>
                    </depends>
                </field>
                <field id="benefit_text" translate="label" type="textarea" sortOrder="30" showInDefault="1"
                       showInWebsite="1" showInStore="1">
                    <label>Benefit Text</label>
                    <depends>
                        <field id="enabled">1</field>
                    </depends>
                </field>
                <field id="tracking_params" translate="label comment" type="text" sortOrder="40"
                       showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Tracking Parameters</label>
                    <comment><![CDATA[Added to the page the shopper lands on after signing up, for example <code>utm_source=shop&amp;utm_medium=confirmation_page</code>.]]></comment>
                    <depends>
                        <field id="enabled">1</field>
                    </depends>
                </field>
            </group>
            <group id="signup_source" translate="label" sortOrder="200" showInDefault="1">
                <label>Sign-up Sources</label>
                <field id="extra_sources" translate="label comment" sortOrder="10" showInDefault="1">
                    <label>Extra Sources</label>
                    <frontend_model>PixelPerfect\NewsletterSignup\Block\Adminhtml\Form\Field\ExtraSignupSources</frontend_model>
                    <backend_model>Magento\Config\Model\Config\Backend\Serialized\ArraySerialized</backend_model>
                    <comment><![CDATA[Places of your own, such as a landing page. Codes use lower-case letters, digits and underscores. Credit a source with the <code>nl_source</code> parameter on any shop link, for example <code>?nl_source=landing_page</code>.]]></comment>
                </field>
            </group>
        </section>
    </system>
</config>
