<?xml version="1.0"?>
<page xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xsi:noNamespaceSchemaLocation="urn:magento:framework:View/Layout/etc/page_configuration.xsd">
    <body>
        <referenceContainer name="content">
            <block class="Magento\Framework\View\Element\Template"
                   name="pixelperfect.newsletter.signup.confirmation"
                   template="PixelPerfect_NewsletterSignup::confirmation-page-invitation.phtml"
                   after="checkout.success" cacheable="false">
                <arguments>
                    <argument name="invitation" xsi:type="object">PixelPerfect\NewsletterSignup\ViewModel\ConfirmationPageInvitation</argument>
                </arguments>
            </block>
        </referenceContainer>
    </body>
</page>
